{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "build",
			"command": "g++.exe",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}\\${fileBasenameNoExtension}.exe",
				"-I",
				"${workspaceFolder}\\raylib-5.5_win64_mingw-w64\\include",
				"-L",
				"${workspaceFolder}\\raylib-5.5_win64_mingw-w64\\lib",
				"-lraylib",
				"-lopengl32",
				"-lgdi32",
				"-lwinmm",
				"-pipe"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "编译 raylib 游戏"
		}
	]
}